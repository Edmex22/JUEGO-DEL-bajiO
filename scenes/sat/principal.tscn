[node name="AgenteFiscal" type="CharacterBody2D" parent="." groups=["npcs"]]
position = Vector2(120, 148)
script = ExtResource("4")
nombre_npc = "C.P. Humberto Salas"
rol = "Agente Fiscal"
dialogos = ["Buenos días. ¿Tiene su RFC a la mano?", "Recuerde que la declaración anual vence en abril.", "Las personas físicas con actividad empresarial deben declarar bimestralmente.", "Si tiene dudas sobre su régimen fiscal, le puedo orientar.", "El SAT tiene un portal en línea para hacer trámites sin venir aquí."]
dialogos_bajo_presupuesto = ["Con el recorte, tenemos menos auditores activos.", "La evasión fiscal sube cuando hay menos fiscalización."]

[node name="ContribuyenteDon" type="CharacterBody2D" parent="." groups=["npcs"]]
position = Vector2(160, 280)
script = ExtResource("4")
nombre_npc = "Don Aurelio"
rol = "Contribuyente"
dialogos = ["Vine a tramitar mi RFC por primera vez.", "Mi negocio lleva 2 años y hasta ahora vengo a regularizarme.", "¿Es muy complicado el trámite?", "Espero que no me pongan multa por el retraso."]

[node name="ContribuyenteSra" type="CharacterBody2D" parent="." groups=["npcs"]]
position = Vector2(300, 280)
script = ExtResource("4")
nombre_npc = "Sra. Beatriz"
rol = "Contribuyente"
dialogos = ["Vine a aclarar una diferencia en mi declaración.", "Me llegó un requerimiento del SAT y no entiendo qué piden.", "Ya contraté a un contador, pero me dijo que viniera yo.", "El trámite en línea me falló tres veces, por eso vine en persona."]

[node name="OrientadorSAT" type="CharacterBody2D" parent="." groups=["npcs"]]
position = Vector2(460, 280)
script = ExtResource("4")
nombre_npc = "Lic. Patricia Leal"
rol = "Orientadora SAT"
dialogos = ["¿En qué le puedo ayudar?", "Para el régimen simplificado de confianza, la tasa es del 1 al 2.5%.", "El CFDI es el comprobante fiscal digital, necesita uno por cada venta.", "Si factura menos de $3.5 millones al año, está en el régimen simplificado."]

