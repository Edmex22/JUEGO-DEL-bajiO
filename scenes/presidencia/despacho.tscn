[node name="PresidenteMunicipal" type="CharacterBody2D" parent="." groups=["npcs"]]
position = Vector2(320, 290)
script = ExtResource("4_npc")
nombre_npc = "Lic. Roberto Garza"
rol = "Presidente Municipal"
dialogos = [
	"Bienvenido. Siéntese, por favor.",
	"Estamos trabajando en mejorar la infraestructura del municipio.",
	"La transparencia y rendición de cuentas son nuestras prioridades.",
	"Si necesita gestionar el presupuesto, puede hacerlo desde aquí.",
	"Recuerde que cada peso del erario debe usarse con responsabilidad."
]
dialogos_bajo_presupuesto = [
	"Estamos en una situación financiera difícil este período.",
	"Vamos a necesitar revisar qué proyectos se pueden diferir.",
	"En crisis, la prioridad es mantener los servicios básicos."
]

[node name="AsesorFinanciero" type="CharacterBody2D" parent="." groups=["npcs"]]
position = Vector2(180, 350)
script = ExtResource("4_npc")
nombre_npc = "C.P. Elena Ruiz"
rol = "Asesora Financiera"
dialogos = [
	"Los ingresos por impuesto predial son nuestra principal fuente.",
	"Le recomiendo revisar el ISR de los negocios locales.",
	"Un municipio sano no debe tener deuda mayor al 30% del presupuesto.",
	"El SAT puede ayudarnos a fiscalizar a contribuyentes omisos."
]

