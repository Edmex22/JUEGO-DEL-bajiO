[node name="DonaPilar" type="CharacterBody2D" parent="." groups=["npcs"]]
position = Vector2(90, 140)
script = ExtResource("4")
nombre_npc = "Doña Pilar"
rol = "Verdulera"
dialogos = ["¡Llévele, llévele! Jitomates frescos del rancho.", "La col y el chile están en oferta hoy.", "Si compra por kilo le doy un jitomate de pilón.", "Los vegetales orgánicos los traen los martes."]
dialogos_bajo_presupuesto = ["Ay, con esta crisis, las ventas están muy bajas.", "La gente ya no compra igual desde que subieron los precios."]

[node name="DonChuy" type="CharacterBody2D" parent="." groups=["npcs"]]
position = Vector2(250, 140)
script = ExtResource("4")
nombre_npc = "Don Chucho"
rol = "Carnicero"
dialogos = ["Buenos días. ¿Qué se le ofrece?", "Tenemos arrachera, costilla y machaca.", "La carne de res viene directa de los ranchos del municipio.", "¿Le pongo algo para el fin de semana?"]

[node name="SeñoraMarta" type="CharacterBody2D" parent="." groups=["npcs"]]
position = Vector2(410, 140)
script = ExtResource("4")
nombre_npc = "Sra. Marta"
rol = "Hierbera"
dialogos = ["Tengo manzanilla, hierba santa y epazote.", "El té de canela con jengibre quita el frío.", "Estas hierbas son medicinales, vienen de la sierra.", "Para el dolor de estómago, nada como la menta."]

[node name="AdministradorMercado" type="CharacterBody2D" parent="." groups=["npcs"]]
position = Vector2(320, 280)
script = ExtResource("4")
nombre_npc = "Lic. Fernanda Cruz"
rol = "Administradora"
dialogos = ["El mercado tiene 85 locales activos.", "Necesitamos mantenimiento en el área de pescadería.", "Las rentas de locales son una fuente de ingreso municipal.", "¿Sabe que el mercado genera 200 empleos directos?"]
dialogos_bajo_presupuesto = ["Sin inversión municipal, el mercado se está deteriorando.", "Los locatarios piden mejoras urgentes en la instalación eléctrica."]

