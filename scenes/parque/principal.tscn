[node name="AbueloJose" type="CharacterBody2D" parent="." groups=["npcs"]]
position = Vector2(240, 200)
script = ExtResource("4")
nombre_npc = "Don José"
rol = "Vecino"
dialogos = ["Aquí vengo todos los días a mi caminata.", "Este parque lo construyeron hace 40 años, cuando yo era joven.", "Antes había más árboles, fueron cortando algunos.", "El kiosco nuevo está muy bonito.", "Ojalá pusieran más bancas, a veces no hay donde sentarse."]

[node name="MamaConNino" type="CharacterBody2D" parent="." groups=["npcs"]]
position = Vector2(420, 200)
script = ExtResource("4")
nombre_npc = "Sofía Mendez"
rol = "Mamá"
dialogos = ["A mi hijo le encanta venir a los juegos.", "Necesitan arreglar el columpio, está oxidado.", "El parque es lo mejor del barrio para las familias.", "¿Sabe si van a poner más iluminación? De noche da miedo."]
dialogos_noche = ["De noche el parque se siente inseguro, hace falta más luz.", "No me gusta traer a mi hijo tan tarde, pero no tuve opción."]

[node name="Deportista" type="CharacterBody2D" parent="." groups=["npcs"]]
position = Vector2(160, 300)
script = ExtResource("4")
nombre_npc = "Roberto Fuentes"
rol = "Deportista"
dialogos = ["Corro aquí todos los días a las 6am.", "El circuito de atletismo debería ser más largo.", "Sería genial tener máquinas de ejercicio al aire libre.", "El parque está bien mantenido, felicidades al municipio."]
dialogos_bajo_presupuesto = ["Últimamente el pasto no lo cortan seguido.", "Se nota que hay recorte, el mantenimiento bajó mucho."]

[node name="VendedorKiosco" type="CharacterBody2D" parent="." groups=["npcs"]]
position = Vector2(60, 240)
script = ExtResource("4")
nombre_npc = "Toño"
rol = "Vendedor"
dialogos = ["¡Elotes, esquites, aguas frescas!", "El kiosco lo rento al municipio, ojalá no suban la cuota.", "Los fines de semana vendo el doble.", "¿Le pongo chile y limón al elote?"]

